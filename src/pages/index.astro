---
import Layout from '../layouts/Layout.astro';
import Root from '@/app/Root';

// Get API URL from environment variable (server-side)
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || 'https://tutoria-api-dev.orangesmoke-8addc8f4.eastus2.azurecontainerapps.io';
---

<Layout>
  <Root client:only="react" apiBaseUrl={apiBaseUrl} />
</Layout>
